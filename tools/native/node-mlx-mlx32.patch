+// MLX 0.32 replaced std::vector<int> with SmallVector<int> for shapes and indices (and uses
+// SmallVector<long long> in places). The JS side keeps seeing a plain array, or a single number
+// meaning a one-dimensional shape.
+template<typename T>
+struct Type<mx::SmallVector<T>> {
+  static constexpr const char* name = "Shape";
+  static napi_status ToNode(napi_env env,
+                            const mx::SmallVector<T>& vec,
+                            napi_value* result) {
+    napi_status s = napi_create_array_with_length(env, vec.size(), result);
+    if (s != napi_ok) return s;
+    for (size_t i = 0; i < vec.size(); ++i) {
+      napi_value el;
+      s = ConvertToNode(env, vec[i], &el);
+      if (s != napi_ok) return s;
+      s = napi_set_element(env, *result, i, el);
+      if (s != napi_ok) return s;
+    }
+    return napi_ok;
+  }
+  static std::optional<mx::SmallVector<T>> FromNode(napi_env env,
+                                                    napi_value value) {
+    if (auto single = FromNodeTo<T>(env, value); single)
+      return mx::SmallVector<T>(1, *single);
+    auto vec = FromNodeTo<std::vector<T>>(env, value);
+    if (!vec) return std::nullopt;
+    return mx::SmallVector<T>(vec->begin(), vec->end());
+  }
+};
