   target_link_libraries(${PROJECT_NAME} delayimp)
 endif()
 
+# Link with MLX.
+#
+# Upstream node-mlx builds its vendored MLX from source, which requires the full Xcode Metal
+# toolchain. On a machine that only has CommandLineTools there is no `metal` compiler, so point
+# MLX_PREFIX at a prebuilt MLX instead (e.g. `brew install mlx`, which ships headers,
+# libmlx.dylib and mlx.metallib for the matching version).
+set(MLX_PREFIX "$ENV{MLX_PREFIX}" CACHE PATH "Prefix of a prebuilt MLX installation")
+if(NOT MLX_PREFIX)
+  execute_process(COMMAND brew --prefix mlx
+                  OUTPUT_VARIABLE MLX_PREFIX
+                  OUTPUT_STRIP_TRAILING_WHITESPACE
+                  ERROR_QUIET)
+endif()
+set(MLX_USE_PREBUILT FALSE)
+if(MLX_PREFIX AND EXISTS "${MLX_PREFIX}/lib/libmlx.dylib")
+  set(MLX_USE_PREBUILT TRUE)
+endif()
+
 # Add source files.
+# src/fft.cc is built against MLX >= 0.26 through the adapters in that file.
+option(MLX_SKIP_FFT "Skip src/fft.cc" OFF)
 file(GLOB SOURCE_FILES "src/*")
+if(MLX_SKIP_FFT)
+  list(FILTER SOURCE_FILES EXCLUDE REGEX "src/fft\\.cc$")
+endif()
 target_sources(${PROJECT_NAME} PRIVATE ${SOURCE_FILES})
 
 # Use kizunapi.
 target_include_directories(${PROJECT_NAME} PRIVATE "deps/kizunapi")
 
-# Link with MLX.
-option(MLX_BUILD_TESTS "Build tests for mlx" OFF)
-option(MLX_BUILD_EXAMPLES "Build examples for mlx" OFF)
-option(MLX_ENABLE_X64_MAC "Enable building for x64 macOS" ON)
-add_subdirectory(deps/mlx)
-target_link_libraries(${PROJECT_NAME} mlx)
+if(MLX_USE_PREBUILT)
+  message(STATUS "Using prebuilt MLX at ${MLX_PREFIX}")
+  target_compile_definitions(${PROJECT_NAME} PRIVATE MLX_GE_026)
+  target_include_directories(${PROJECT_NAME} PRIVATE "${MLX_PREFIX}/include")
+  target_link_libraries(${PROJECT_NAME} "${MLX_PREFIX}/lib/libmlx.dylib")
+  set_target_properties(${PROJECT_NAME} PROPERTIES
+                        BUILD_RPATH "${MLX_PREFIX}/lib"
+                        INSTALL_RPATH "${MLX_PREFIX}/lib")
+else()
+  option(MLX_BUILD_TESTS "Build tests for mlx" OFF)
+  option(MLX_BUILD_EXAMPLES "Build examples for mlx" OFF)
+  option(MLX_ENABLE_X64_MAC "Enable building for x64 macOS" ON)
+  add_subdirectory(deps/mlx)
+  target_link_libraries(${PROJECT_NAME} mlx)
+endif()
